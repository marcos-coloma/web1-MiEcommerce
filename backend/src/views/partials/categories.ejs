<div class="<%= categoryWrapperClass %>">
    <ul class="category-list">

        <% categories.forEach((category, index) => { %>

            <li class="<%= index === 0 ? 'category-item-single' : 'category-item' %>">
                <a href="/products?category=<%= category.name %>">

                    <img 
                        src="/img/ui/<%= category.icon || 'default-icon.svg' %>" 
                        alt="<%= category.name %>" 
                        class="category-image"
                        onerror="this.src='/img/ui/default-icon.svg'"
                    >

                    <p class="category-text">
                        <%= category.name.charAt(0).toUpperCase() + category.name.slice(1) %>
                    </p>

                </a>
            </li>

        <% }) %>

    </ul>
</div>
